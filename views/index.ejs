<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Weather4farmer</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <nav class="navbar bg-white">
    <div class="container">

        <a class="navbar-brand fw-bold" href="#">
            Weather4Farmer
        </a>

        <div class="navbar-nav nav-links">
            <a class="nav-link active" href="#">Home</a>
            <a class="nav-link" href="#">Forecast</a>
            <a class="nav-link" href="#">About</a>
        </div>

    </div>
</nav>

 <section class="hero">
    <div class="container hero-content">

        <h1 class="display-3 fw-bold">
            Know the weather.<br>
            <span>For the farm.</span>
        </h1>

        <p class="lead">
            Weather information to help farmers make better decisions.
        </p>

        <div class="input-group search-box">
            <input
                type="text"
                class="form-control"
                placeholder="Enter a town or location">

            <button class="btn btn-success">
                Search
            </button>
        </div>

    </div>
</section>

    <div class="container py-5">

        <h1 class="text-center mb-5">Weather4farmer</h1>

        <div class="card text-center shadow-sm mx-auto" style="max-width: 400px;">
            <div class="card-body">

                <h2 class="card-title">Today's Weather</h2>

                <p class="display-4 fw-bold">
                    <%= todayMax %>°C
                </p>

                <p class="text-muted">Maximum temperature</p>

            </div>
        </div>

    </div>


</body>
</html>