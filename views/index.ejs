<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Weather4farmer</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
   <body>

    <div class="container py-5">

        <h1 class="text-center mb-5">Weather4farmer</h1>

        <div class="card text-center shadow-sm mx-auto" style="max-width: 400px;">
            <div class="card-body">

                <h2 class="card-title">Today's Weather</h2>

                <p class="display-4 fw-bold">
                    <%= todayMax %>°C
                </p>

                <p class="text-muted">Maximum temperature</p>

            </div>
        </div>

    </div>

</body>
</body>
</html>